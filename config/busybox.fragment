# mbaos BusyBox configuration fragment.
#
# Applied on top of `allnoconfig` and verified line by line, like the kernel
# (scripts/busybox.sh). Every applet here earns its place: it is used by our
# boot scripts, or it is a basic tool for working on the system by hand.
# Later phases replace pieces where a better tool helps.

## ---- Build -------------------------------------------------------------
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_DEVPTS=y
CONFIG_LFS=y
# Dynamically linked against musl: one shared libc for everything we ship.
# CONFIG_STATIC is not set
CONFIG_PIE=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
# CONFIG_FEATURE_SUID is not set
CONFIG_UNICODE_SUPPORT=y
CONFIG_FEATURE_CHECK_UNICODE_IN_ENV=y

## ---- Shell: ash ------------------------------------------------------------
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_READ_FRAC=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y

## ---- Login, accounts ---------------------------------------------------------
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_PASSWD=y
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
# allnoconfig leaves these at 0 (and FIRST/LAST_SYSTEM_ID are clamped to
# 0..LAST_ID), which made the first user uid 1, a system ID.
# System accounts 100-999; normal users therefore start at 1000.
CONFIG_LAST_ID=60000
CONFIG_FIRST_SYSTEM_ID=100
CONFIG_LAST_SYSTEM_ID=999
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
# root may log in on any console (there is no remote login)
# CONFIG_FEATURE_SECURETTY is not set
CONFIG_ID=y
CONFIG_WHOAMI=y

## ---- System ----------------------------------------------------------------
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_HOSTNAME=y
CONFIG_BB_SYSCTL=y
CONFIG_DMESG=y
CONFIG_FEATURE_DMESG_PRETTY=y
CONFIG_FLOCK=y
CONFIG_STTY=y
CONFIG_SETSID=y
CONFIG_POWEROFF=y
CONFIG_HALT=y
CONFIG_REBOOT=y
CONFIG_PS=y
CONFIG_FEATURE_PS_WIDE=y
CONFIG_FEATURE_PS_LONG=y
CONFIG_TOP=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_NICE=y
CONFIG_FSTRIM=y
CONFIG_BLKID=y
CONFIG_LSUSB=y
CONFIG_LSPCI=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_SYNC=y
CONFIG_CHROOT=y
CONFIG_UNAME=y
CONFIG_DATE=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_TTY=y
CONFIG_WATCH=y

## ---- Files and text ----------------------------------------------------------
CONFIG_LS=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_MKTEMP=y
CONFIG_MKFIFO=y
CONFIG_DD=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_TEE=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_PASTE=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_WC=y
CONFIG_DIFF=y
CONFIG_CMP=y
CONFIG_STRINGS=y
CONFIG_HEXDUMP=y
CONFIG_TAC=y
CONFIG_SEQ=y
CONFIG_EXPR=y
CONFIG_WHICH=y
CONFIG_VI=y
CONFIG_LESS=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_UNXZ=y

## ---- Shell utilities -----------------------------------------------------------
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_ENV=y
CONFIG_PWD=y
CONFIG_NPROC=y
CONFIG_TIME=y
CONFIG_TIMEOUT=y
CONFIG_NOHUP=y
CONFIG_YES=y
